#include <limits.h> 
#include <stdio.h>
#define MAX 20
int V, E;
int graph[MAX][MAX];
#define INFINITY 99999

void dijkstra(int G[MAX][MAX], int n, int startnode) {
    int dist[MAX], parent[MAX], visited[MAX];

    for (int i = 1; i <= n; i++) {
        dist[i] = INFINITY;
        parent[i] = 0;
        visited[i] = 0;
    }
    dist[startnode] = 0;

    for (int i = 1; i <= n; i++) {
        int u = -1, minDist = INFINITY;
        for (int j = 1; j <= n; j++) {
            if (!visited[j] && dist[j] < minDist) {
                minDist = dist[j];
                u = j;
            }
        }
        if (u == -1) break;
        visited[u] = 1;
        for (int v = 1; v <= n; v++) {
            if (!visited[v] && G[u][v] != 0) {
                if (dist[u] + G[u][v] < dist[v]) {
                    dist[v] = dist[u] + G[u][v];
                    parent[v] = u;
                }
            }
        }
    }

    printf("Node\tDistance\tPath\n");
    for (int i = 1; i <= n; i++) {
        if (i == startnode) continue;
        if (dist[i] == INFINITY) {
            printf("%4d\t%8s\t%s\n", i, "INF", "NO PATH");
        } else {
            int pathNodes[20], cnt = 0, cur = i;
            while (cur != 0) {
                pathNodes[cnt++] = cur;
                cur = parent[cur];
            }
            char path[500];
            int pos = 0;
            for (int k = 0; k < cnt; k++) {
                pos += sprintf(path + pos, "%d", pathNodes[k]);
                if (k < cnt - 1)
                    pos += sprintf(path + pos, "<-");
            }
            printf("%4d\t%8d\t%s\n", i, dist[i], path);
        }
	}
}
int main() { 
	int s, d, w, i, j;
	printf("Enter the number of vertices : ");
	scanf("%d", &V);
	printf("Enter the number of edges : ");
	scanf("%d", &E);
	for(i = 1 ; i <= V; i++) {
		for(j = 1; j <= V; j++) {
			graph[i][i] = 0;
		}
	}
	for(i = 1; i <= E; i++) {
		printf("Enter source : ");
		scanf("%d", &s);
		printf("Enter destination : ");
		scanf("%d", &d);
		printf("Enter weight : ");
		scanf("%d", &w);
		if(s > V || d > V || s <= 0 || d <= 0) {
			printf("Invalid index. Try again.\n");
			i--;
			continue;
		} else {
			graph[s][d] = w;
		}
	}
	printf("Enter the source :");
	scanf("%d", &s);
	dijkstra(graph, V, s); 
	return 0; 
} 
