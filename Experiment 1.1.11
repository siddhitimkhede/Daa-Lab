#include <stdio.h>

int max(int a, int b) {
    return a > b ? a : b;
}

int main() {
    int n;
    scanf("%d", &n);

    int val[1000], wt[1000];
    for (int i = 0; i < n; i++)
        scanf("%d", &val[i]);
    for (int i = 0; i < n; i++)
        scanf("%d", &wt[i]);

    int W;
    scanf("%d", &W);

    // dp[w] = max value achievable with capacity w
    int dp[1001] = {0};

    for (int i = 0; i < n; i++) {
        for (int w = W; w >= wt[i]; w--) {
            dp[w] = max(dp[w], dp[w - wt[i]] + val[i]);
        }
    }

    printf("%d\n", dp[W]);
    return 0;
}   
