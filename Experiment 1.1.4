#include <stdio.h>
#include <stdlib.h>
#include <limits.h>

typedef struct {
    int u, v, weight;
} Edge;

// Disjoint Set (Union-Find) structures
typedef struct {
    int *parent;
    int *rank;
} DSU;

// Initialize DSU
DSU* createDSU(int V) {
    DSU *dsu = (DSU*)malloc(sizeof(DSU));
    dsu->parent = (int*)malloc(V * sizeof(int));
    dsu->rank = (int*)malloc(V * sizeof(int));
    
    for (int i = 0; i < V; i++) {
        dsu->parent[i] = i; // Initially each node is its own parent
        dsu->rank[i] = 0;   // Rank is initially 0
    }
    return dsu;
}

// Find with path compression
int find(DSU *dsu, int i) {
    if (dsu->parent[i] != i) {
        dsu->parent[i] = find(dsu, dsu->parent[i]); // Path compression
    }
    return dsu->parent[i];
}

// Union by rank
void unionSets(DSU *dsu, int i, int j) {
    int rootI = find(dsu, i);
    int rootJ = find(dsu, j);

    if (rootI != rootJ) {
        if (dsu->rank[rootI] < dsu->rank[rootJ]) {
            dsu->parent[rootI] = rootJ;
        } else if (dsu->rank[rootI] > dsu->rank[rootJ]) {
            dsu->parent[rootJ] = rootI;
        } else {
            dsu->parent[rootJ] = rootI;
            dsu->rank[rootI]++;
        }
    }
}

// Comparison function for sorting edges by weight
int compareEdges(const void *a, const void *b) {
    Edge *edgeA = (Edge *)a;
    Edge *edgeB = (Edge *)b;
    
    // Sort by weight ascending
    if (edgeA->weight != edgeB->weight) {
        return edgeA->weight - edgeB->weight;
    }
    // If weights are equal, maintain original order (row-wise)
    // Since we extract edges row-by-row, qsort is stable for equal keys 
    // if we don't explicitly change the order, but standard qsort isn't guaranteed stable.
    // To ensure strict row-wise order for ties, we can add a tie-breaker if needed.
    // However, the problem says "row-wise order in the upper triangular part".
    // Our extraction loop iterates i from 0 to V, j from i+1 to V.
    // If we rely on qsort stability, it might not work. 
    // Let's add a tie-breaker based on u then v to be safe and deterministic.
    if (edgeA->u != edgeB->u) {
        return edgeA->u - edgeB->u;
    }
    return edgeA->v - edgeB->v;
}

void kruskalMST(int **cost, int V) {
    // 1. Collect all edges from the upper triangular part of the matrix
    // Max edges = V*(V-1)/2
    int maxEdges = V * (V - 1) / 2;
    Edge *edges = (Edge*)malloc(maxEdges * sizeof(Edge));
    int edgeCount = 0;

    for (int i = 0; i < V; i++) {
        for (int j = i + 1; j < V; j++) {
            if (cost[i][j] != 9999) { // 9999 represents infinity (no edge)
                edges[edgeCount].u = i;
                edges[edgeCount].v = j;
                edges[edgeCount].weight = cost[i][j];
                edgeCount++;
            }
        }
    }

    // 2. Sort edges by weight
    qsort(edges, edgeCount, sizeof(Edge), compareEdges);

    // 3. Initialize Union-Find
    DSU *dsu = createDSU(V);

    int edgesSelected = 0;
    int totalCost = 0;
    int edgeIndex = 0;

    // 4. Iterate through sorted edges and build MST
    while (edgesSelected < V - 1 && edgeIndex < edgeCount) {
        Edge nextEdge = edges[edgeIndex];
        
        int rootU = find(dsu, nextEdge.u);
        int rootV = find(dsu, nextEdge.v);

        // If u and v are not in the same component, add edge to MST
        if (rootU != rootV) {
            printf("Edge %d:(%d, %d) cost:%d\n", edgesSelected, nextEdge.u, nextEdge.v, nextEdge.weight);
            unionSets(dsu, rootU, rootV);
            totalCost += nextEdge.weight;
            edgesSelected++;
        }
        edgeIndex++;
    }

    printf("Minimum cost= %d\n", totalCost);

    // Cleanup
    free(edges);
    free(dsu->parent);
    free(dsu->rank);
    free(dsu);
}




int main() {
    int V;
    printf("No of vertices: ");
    scanf("%d", &V);

    int **cost = (int **)malloc(V * sizeof(int *));
    for (int i = 0; i < V; i++)
        cost[i] = (int *)malloc(V * sizeof(int));

    printf("Adjacency matrix:\n");
    for (int i = 0; i < V; i++)
        for (int j = 0; j < V; j++)
            scanf("%d", &cost[i][j]);

    kruskalMST(cost, V);

    for (int i = 0; i < V; i++)
        free(cost[i]);
    free(cost);

    return 0;
}
