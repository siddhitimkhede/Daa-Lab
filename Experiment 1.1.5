#include <stdio.h>

int n, target;
int set[100];
int subset[100], subsetSize = 0;

int allSubsets[10000][100];
int subsetSizes[10000];
int count = 0;

void backtrack(int index, int currentSum) {
    if (currentSum == target) {
        for (int i = 0; i < subsetSize; i++)
            allSubsets[count][i] = subset[i];
        subsetSizes[count] = subsetSize;
        count++;
        return;
    }
    if (index >= n || currentSum > target)
        return;

    subset[subsetSize++] = set[index];
    backtrack(index + 1, currentSum + set[index]);
    subsetSize--;

    backtrack(index + 1, currentSum);
}

int main() {
    scanf("%d", &n);
    for (int i = 0; i < n; i++)
        scanf("%d", &set[i]);
    scanf("%d", &target);

    backtrack(0, 0);

    if (count == 0) {
        printf("-1\n");
    } else {
        for (int i = count - 1; i >= 0; i--) {
            for (int j = 0; j < subsetSizes[i]; j++) {
                printf("%d ", allSubsets[i][j]);
            }
            printf("\n");
        }
    }
    return 0;
}   
